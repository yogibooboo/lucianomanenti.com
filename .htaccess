# .htaccess for Aruba Linux Hosting

RewriteEngine On

# 1. Force HTTPS (Safe for Aruba)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Le destinazioni dei RedirectMatch sono scritte per intero (https://www...):
# con il solo percorso Apache su Aruba rimandava a http://, e il visitatore
# faceva due salti (https -> http -> https) invece di uno (19/11/2026).

# 1b. Permanent Redirection for old Scala40 V1 (Case native and V1)
RedirectMatch 301 ^/scala40[vV]1\.html$ https://www.lucianomanenti.com/scala40.html

# 1c. Permanent Redirection for Tetra, renamed Mattoncini / Bricks (6/10/2026)
RedirectMatch 301 ^/tetra-en\.html$ https://www.lucianomanenti.com/mattoncini-en.html
RedirectMatch 301 ^/tetra\.html$ https://www.lucianomanenti.com/mattoncini.html

# 1d. WooWoo: i file woowoo2 prendono il nome del gioco, e la guida
# diventa regole (17/11/2026)
RedirectMatch 301 ^/woowoo2-en\.html$ https://www.lucianomanenti.com/woowoo-en.html
RedirectMatch 301 ^/woowoo2\.html$ https://www.lucianomanenti.com/woowoo.html
RedirectMatch 301 ^/guida-woowoo-en\.html$ https://www.lucianomanenti.com/regole-woowoo-en.html
RedirectMatch 301 ^/guida-woowoo\.html$ https://www.lucianomanenti.com/regole-woowoo.html

# 1e. Quadrati: la guida diventa regole (17/11/2026)
RedirectMatch 301 ^/guida-quadrati-en\.html$ https://www.lucianomanenti.com/regole-quadrati-en.html
RedirectMatch 301 ^/guida-quadrati\.html$ https://www.lucianomanenti.com/regole-quadrati.html

# 1f. Battaglia navale: la guida diventa regole (17/11/2026)
RedirectMatch 301 ^/guida-battaglia-navale-en\.html$ https://www.lucianomanenti.com/regole-battaglia-navale-en.html
RedirectMatch 301 ^/guida-battaglia-navale\.html$ https://www.lucianomanenti.com/regole-battaglia-navale.html

# 1g. Navale solitario: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/guida-navale-en\.html$ https://www.lucianomanenti.com/regole-navale-en.html
RedirectMatch 301 ^/guida-navale\.html$ https://www.lucianomanenti.com/regole-navale.html

# 1h. Mahjong: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/guida-mahjong-en\.html$ https://www.lucianomanenti.com/regole-mahjong-en.html
RedirectMatch 301 ^/guida-mahjong\.html$ https://www.lucianomanenti.com/regole-mahjong.html

# 1i. Domino: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/guida-domino-en\.html$ https://www.lucianomanenti.com/regole-domino-en.html
RedirectMatch 301 ^/guida-domino\.html$ https://www.lucianomanenti.com/regole-domino.html

# 1j. Campo minato: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/guida-minato-en\.html$ https://www.lucianomanenti.com/regole-minato-en.html
RedirectMatch 301 ^/guida-minato\.html$ https://www.lucianomanenti.com/regole-minato.html

# 1k. Mattoncini: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/guida-mattoncini-en\.html$ https://www.lucianomanenti.com/regole-mattoncini-en.html
RedirectMatch 301 ^/guida-mattoncini\.html$ https://www.lucianomanenti.com/regole-mattoncini.html

# 1l. Scorciatoie: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/guida-scorciatoie-en\.html$ https://www.lucianomanenti.com/regole-scorciatoie-en.html
RedirectMatch 301 ^/guida-scorciatoie\.html$ https://www.lucianomanenti.com/regole-scorciatoie.html

# 1m. Musica, intervalli: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/musica/intervalli/guida-intervalli-en\.html$ https://www.lucianomanenti.com/musica/intervalli/regole-intervalli-en.html
RedirectMatch 301 ^/musica/intervalli/guida-intervalli\.html$ https://www.lucianomanenti.com/musica/intervalli/regole-intervalli.html

# 1n. Musica, accordi: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/musica/accordi/guida-accordi-en\.html$ https://www.lucianomanenti.com/musica/accordi/regole-accordi-en.html
RedirectMatch 301 ^/musica/accordi/guida-accordi\.html$ https://www.lucianomanenti.com/musica/accordi/regole-accordi.html

# 1o. Musica, scale: la guida diventa regole (18/11/2026)
RedirectMatch 301 ^/musica/scale/guida-scale-en\.html$ https://www.lucianomanenti.com/musica/scale/regole-scale-en.html
RedirectMatch 301 ^/musica/scale/guida-scale\.html$ https://www.lucianomanenti.com/musica/scale/regole-scale.html

# 1p. Metronomo: va in musica/metronomo/ come gli altri strumenti, e la guida
# diventa regole (18/11/2026)
RedirectMatch 301 ^/metronome-en\.html$ https://www.lucianomanenti.com/musica/metronomo/index-en.html
RedirectMatch 301 ^/metronome\.html$ https://www.lucianomanenti.com/musica/metronomo/
RedirectMatch 301 ^/guida-metronomo-en\.html$ https://www.lucianomanenti.com/musica/metronomo/regole-metronomo-en.html
RedirectMatch 301 ^/guida-metronomo\.html$ https://www.lucianomanenti.com/musica/metronomo/regole-metronomo.html

# 1q. Indirizzi vecchi che Search Console vede ancora e oggi danno 404
# (19/11/2026): la guida del vecchio Tetra, la vecchia pagina personale e i
# percorsi con la cartella del sito ripetuta davanti.
RedirectMatch 301 ^/guida-tetra-en\.html$ https://www.lucianomanenti.com/regole-mattoncini-en.html
RedirectMatch 301 ^/guida-tetra\.html$ https://www.lucianomanenti.com/regole-mattoncini.html
RedirectMatch 301 ^/lucianomanenti\.html$ https://www.lucianomanenti.com/
RedirectMatch 301 ^/lucianomanenti(\.com)?/(.*)$ https://www.lucianomanenti.com/$2

# 2. Optimized Caching Rules
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML: never cache (always fetch fresh)
    ExpiresByType text/html "access plus 0 seconds"
    # Static assets: cache long (versioned with ?v=x.x in URLs)
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>

# Force no-cache for HTML (stronger than Expires for mobile browsers)
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Force no-cache for the files shared by many pages: they change without a
# page-by-page bump, so there is no ?v= to raise.
# Not no-store: that would mean "re-download it whole every time", 40 KB a
# visit. no-cache gives the same freshness guarantee -- the browser asks the
# server every time, so an upload reaches everybody at once -- but it lets the
# browser keep its copy, so an unchanged file answers 304 with an empty body.
# Expires "0" stays on purpose: without it mod_expires would put a +1 month
# Expires on these files, and an old HTTP/1.0 proxy would trust that.
# Verified on 10 November 2026 on the two .js: Aruba sends Last-Modified (no
# ETag) on both and answers 304 Not Modified to a conditional request.
# testo.css joined the list on 10 November 2026: it is the one stylesheet of the
# 62 text pages, and a ?v= on it would have to be raised in 62 pages at once --
# exactly the work the shared file is there to remove.
<FilesMatch "^(game-layout|site|pubblicita|promozioni)\.js$|^testo\.css$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# 3. Compression (added 9 November 2026)
# Aruba already compresses html, css, json and svg by itself, but NOT
# JavaScript: it serves .js as text/javascript, and the default DEFLATE list
# only carries application/javascript. Same mismatch as the Expires block
# above, where text/javascript had to be spelled out next to the other one.
# Measured on 9 November 2026: game-layout.js 144 KB -> 39 KB, site.js
# 12,5 KB -> 4 KB, burraco-core.js 195 KB -> 46 KB.
# The IfModule wrapper is not decoration: without it, a host that lacks
# mod_deflate answers 500 on every page of the site.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
</IfModule>
