{
  "manifest_version": 3,
  "name": "Amazon & AliExpress Deal Catcher",
  "version": "1.2",
  "description": "Cattura l'ASIN da Amazon o il Product ID da qualsiasi variante di AliExpress e lo salva nel server locale",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.amazon.it/*",
    "https://*.amazon.com/*",
    "https://*/*aliexpress*/*",
    "http://localhost/*",
    "http://*.local/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Apri Catcher Offerte"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "deal-catcher@lucianomanenti.com",
      "strict_min_version": "109.0"
    }
  }
}
