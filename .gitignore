# --- Cartella banner/ ---
# Il codice PHP della console va versionato; restano fuori le credenziali,
# i dati che si aggiornano da soli e le librerie di terze parti.
banner/config.php
banner/newdeals.json
banner/pending_ali.json
banner/scartati_ali.json
banner/miei_product_ids_ali.json
banner/miei_asin.json
banner/*.json.tmp
banner/*.bak-*
banner/phpmailer/
banner/*.jpg
banner/*.png

# --- Cartella stats/ ---
# Stessa regola dei banner: il codice si versiona, le credenziali no.
# Il file .locale e' quello del MySQL di Local: le credenziali del database non
# escono da 127.0.0.1, ma dentro ci sono anche chiave_prova e chiave_export, e
# quelle valgono anche online. Il repo e' pubblico.
stats/stats-config.php
stats/stats-config.locale.php

# --- WooWoo ---
# Il gioco si chiama WooWoo ma i file portano il nome woowoo2: il primo
# tentativo, quello coi file woowoo.*, resta solo sul disco.

# La cartella dev/ tiene il materiale che viene dal dischetto Kingsoft del
# 1992: le piastrelle estratte da Loco1.ilbm, i quarantacinque quadri
# originali e le copie di sicurezza. Sono un riferimento tecnico, non roba
# nostra, e questo repo e' pubblico. Sta tutto li' dentro perche' dev/ non si
# carica mai sul server per FTP: una cartella sola invece di una regola per
# file.
#
# La regola e' ribaltata: QUI DENTRO E' TUTTO FUORI, tranne quello che si
# nomina sotto. Cosi' un file nuovo buttato in dev/ e' escluso da solo, senza
# doversene ricordare. Gli strumenti nostri, che di Kingsoft non hanno niente,
# si versionano uno per uno.
dev/*
!dev/woowoo2-editor.html
!dev/woowoo2-innesto-vecchio.js
!dev/woowoo2-schemi-nostri.json

# woowoo2-mie.js invece si versiona: era una copia dei quadri del dischetto,
# ma i livelli N..X sono stati svuotati e resta disegnata solo M, che e' roba
# nostra. La copia integra di prima e' in dev/dischetto/.
